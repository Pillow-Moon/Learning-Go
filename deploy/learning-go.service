[Unit]
Description=Learning-Go (围棋 AI 教学平台)
After=network.target

[Service]
Type=simple
# __PROJECT_DIR__ 由 deploy/setup_server.sh 替换为实际项目路径
WorkingDirectory=__PROJECT_DIR__/backend
Environment="PATH=__PROJECT_DIR__/backend/.venv/bin"
ExecStart=__PROJECT_DIR__/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
