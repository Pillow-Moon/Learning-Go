# ===== 应用配置 =====
APP_NAME=Learning-Go
DEBUG=true

# ===== 数据库 =====
# SQLite 数据库文件路径（相对于 backend 目录）
DATABASE_URL=sqlite:///./learning_go.db

# ===== DeepSeek API（阶段三解说管线使用）=====
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 解说任务用 Flash 即可（KataGo 负责推理，LLM 只负责 narration）；
# 如需更高段位的细腻讲解可换 deepseek-v4-pro（3 倍价格）
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== KataGo（阶段二使用）=====
KATAGO_BINARY=./katago/katago.exe
KATAGO_MODEL=./katago/models/b10c384h6.bin.gz
KATAGO_CONFIG=./katago/katago_gtp.cfg
KATAGO_ANALYSIS_CONFIG=./katago/katago_analysis.cfg
